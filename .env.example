# ==============================================================================
# GreeksView Congressional Trading Crawler Configuration
# ==============================================================================

# Target Database Connection
# Defaults to local SQLite if empty: sqlite:///data/congressional_crawler.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_SCHEMA=public
PGSSL=false

# House Clerk Endpoints
HOUSE_INDEX_BASE_URL=https://disclosures-clerk.house.gov/public_disc/financial-pdfs
HOUSE_PDF_BASE_URL=https://disclosures-clerk.house.gov/public_disc/ptr-pdfs

# Ingestion Settings
DEFAULT_YEAR=2024
CRAWLER_BATCH_SIZE=50
MAX_CONCURRENT_DOWNLOADS=5
REQUEST_TIMEOUT_SECONDS=30.0
HTTP_MAX_RETRIES=3

# Local Simulation & Mock Mode
SIMULATION_MODE=false
MOCK_FIXTURES_DIR=tests/fixtures

# Alpha Vantage Feeds Harvester
# Set your Alpha Vantage API key here or in parent ../greeksview/.env
ALPHAVANTAGE_API_KEY=your_alpha_vantage_api_key_here
ALPHAVANTAGE_BASE_URL=https://www.alphavantage.co/query
# The key is shared with the GreeksView product, which uses most of the key's
# per-minute and per-second budget. Fit these inside what is left.
ALPHAVANTAGE_MAX_PER_SECOND=1
ALPHAVANTAGE_RPM=9
ALPHAVANTAGE_COOLDOWN_MS=2000

